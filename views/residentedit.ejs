<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Resident - <%= resident.name %></title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
            padding: 30px 15px;
        }

        .container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            background: white;
            padding: 28px 24px;
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }

        h1 {
            text-align: center;
            color: #0f172a;
            font-size: 22px;
            margin-bottom: 4px;
        }

        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-row {
            display: flex;
            gap: 10px;
        }

        .form-row .form-group {
            flex: 1;
        }

        label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 4px;
        }

        input, textarea, select {
            width: 100%;
            padding: 9px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-family: inherit;
            font-size: 13.5px;
            outline: none;
            background: #f8fafc;
            color: #1e293b;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        input:focus, textarea:focus, select:focus {
            border-color: #2563eb;
            background: white;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        button {
            width: 100%;
            padding: 11px;
            background: #10b981;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            margin-top: 10px;
            transition: background 0.2s ease;
        }

        button:hover {
            background: #059669;
        }

        .nav-links {
            text-align: center;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid #f1f5f9;
        }

        a {
            display: inline-block;
            margin: 0 8px;
            text-decoration: none;
            color: #2563eb;
            font-size: 13.5px;
            font-weight: 600;
        }

        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

<div class="container">

    <h1>✏️ Update Resident Details</h1>
    <div class="subtitle">Wing <%= resident.wing %> - Flat <%= resident.flatNo %></div>

    <form action="/residents/edit/<%= resident._id %>" method="post">

        <div class="form-group">
            <label>Resident Full Name *</label>
            <input type="text" name="name" value="<%= resident.name %>" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Wing *</label>
                <select name="wing" required>
                    <option value="A" <%= resident.wing === 'A' ? 'selected' : '' %>>Wing A</option>
                    <option value="B" <%= resident.wing === 'B' ? 'selected' : '' %>>Wing B</option>
                    <option value="C" <%= resident.wing === 'C' ? 'selected' : '' %>>Wing C</option>
                    <option value="D" <%= resident.wing === 'D' ? 'selected' : '' %>>Wing D</option>
                    <option value="E" <%= resident.wing === 'E' ? 'selected' : '' %>>Wing E</option>
                </select>
            </div>

            <div class="form-group">
                <label>Flat Number *</label>
                <input type="text" name="flatNo" value="<%= resident.flatNo %>" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Floor Number *</label>
                <input type="number" name="floor" value="<%= resident.floor %>" min="0" required>
            </div>

            <div class="form-group">
                <label>Resident Type *</label>
                <select name="residentType" required>
                    <option value="Owner" <%= resident.residentType === 'Owner' ? 'selected' : '' %>>Owner</option>
                    <option value="Tenant" <%= resident.residentType === 'Tenant' ? 'selected' : '' %>>Tenant</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="email" value="<%= resident.email %>" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Primary Phone *</label>
                <input type="tel" name="phone" value="<%= resident.phone %>" required>
            </div>

            <div class="form-group">
                <label>Emergency Contact *</label>
                <input type="tel" name="emergencyContact" value="<%= resident.emergencyContact %>" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Family Members Count *</label>
                <input type="number" name="membersCount" value="<%= resident.membersCount %>" min="1" required>
            </div>

            <div class="form-group">
                <label>Vehicle Number</label>
                <input type="text" name="vehicleNo" value="<%= resident.vehicleNo || '' %>">
            </div>
        </div>

        <div class="form-group">
            <label>Residing Since</label>
            <input type="text" name="ownershipSince" value="<%= resident.ownershipSince || '' %>">
        </div>

        <button type="submit">💾 Save Changes</button>

    </form>

    <div class="nav-links">
        <a href="/residents/view">🏢 View Directory</a>
        <a href="/">🏠 Home Dashboard</a>
    </div>

</div>

</body>
</html>
