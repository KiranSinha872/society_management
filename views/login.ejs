<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Society & Staff Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: white;
            width: 100%;
            max-width: 420px;
            padding: 32px 28px;
            border-radius: 14px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
            text-align: center;
        }

        .logo-icon {
            font-size: 38px;
            margin-bottom: 8px;
        }

        h1 {
            font-size: 22px;
            color: #0f172a;
            margin-bottom: 6px;
            font-weight: 700;
        }

        p.subtitle {
            color: #64748b;
            font-size: 13.5px;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            text-align: left;
        }

        .alert-msg {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            text-align: left;
        }

        .form-group {
            margin-bottom: 14px;
            text-align: left;
        }

        label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 5px;
        }

        input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            background: #f8fafc;
            color: #0f172a;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        input:focus {
            border-color: #2563eb;
            background: white;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        button {
            width: 100%;
            padding: 11px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            margin-top: 10px;
            transition: background 0.2s ease;
        }

        button:hover {
            background: #1d4ed8;
        }

        .back-link {
            display: block;
            margin-top: 20px;
            font-size: 13px;
            color: #64748b;
            text-decoration: none;
        }

        .back-link:hover {
            color: #2563eb;
            text-decoration: underline;
        }

        .info-box {
            margin-top: 16px;
            padding: 12px;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            font-size: 12px;
            color: #475569;
            text-align: left;
            line-height: 1.5;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="logo-icon">🏢</div>
    <h1>Portal Authentication</h1>
    <p class="subtitle">Resident, Staff & Admin Login</p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">⚠️ <%= error %></div>
    <% } %>

    <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="alert-msg">ℹ️ <%= msg %></div>
    <% } %>

    <form id="loginForm" action="/login" method="post" onsubmit="handleLoginSubmit(event)">
        <div class="form-group">
            <label>Registered Email</label>
            <input type="email" name="email" required placeholder="your email address...">
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required placeholder="Enter your password...">
        </div>

        <button type="submit" id="loginBtn">🔐 Login to Account</button>
    </form>

    <div style="margin-top: 18px; font-size: 13.5px; color: #64748b;">
        Resident without an account? <a href="/register" style="color: #2563eb; font-weight: 600; text-decoration: none;">Register here</a>
    </div>

    <div class="info-box">
        <strong>Roles:</strong><br>
        👤 <strong>Residents:</strong> Use registered email & password.<br>
        🛡️ <strong>Admin:</strong> <code>sinhakiran872@gmail.com</code> (Password: <code>Kiran@2006</code>)<br>
        👷 <strong>Maintenance Staff:</strong> Use registered staff email & password.
    </div>

    <a class="back-link" href="/">← Return to Public Dashboard</a>
</div>

<script>
    function handleLoginSubmit() {
        const btn = document.getElementById('loginBtn');
        btn.disabled = true;
        btn.innerHTML = '<span>⏳ Signing In...</span>';
        btn.style.opacity = '0.8';
        return true;
    }
</script>

</body>
</html>

