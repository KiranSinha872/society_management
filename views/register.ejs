<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resident Registration - Society Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .auth-card {
            background: white;
            width: 100%;
            max-width: 480px;
            padding: 32px 28px;
            border-radius: 14px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
            text-align: center;
        }

        .logo-icon {
            font-size: 38px;
            margin-bottom: 8px;
        }

        h1 {
            font-size: 22px;
            color: #0f172a;
            margin-bottom: 6px;
            font-weight: 700;
        }

        p.subtitle {
            color: #64748b;
            font-size: 13.5px;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            text-align: left;
        }

        .alert-msg {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            text-align: left;
        }

        .form-group {
            margin-bottom: 14px;
            text-align: left;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        @media (max-width: 420px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 5px;
        }

        input, select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-family: inherit;
            font-size: 13.5px;
            outline: none;
            background: #f8fafc;
            color: #0f172a;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        input:focus, select:focus {
            border-color: #2563eb;
            background: white;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .password-hint {
            font-size: 11px;
            color: #64748b;
            margin-top: 4px;
        }

        button.btn-submit {
            width: 100%;
            padding: 11px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            margin-top: 12px;
            transition: background 0.2s ease, opacity 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        button.btn-submit:hover {
            background: #1d4ed8;
        }

        button.btn-submit:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            opacity: 0.8;
        }

        .switch-auth {
            margin-top: 20px;
            font-size: 13px;
            color: #64748b;
        }

        .switch-auth a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        .switch-auth a:hover {
            text-decoration: underline;
        }

        .back-link {
            display: block;
            margin-top: 14px;
            font-size: 12.5px;
            color: #94a3b8;
            text-decoration: none;
        }

        .back-link:hover {
            color: #64748b;
        }
    </style>
</head>
<body>

<div class="auth-card">
    <div class="logo-icon">📝</div>
    <h1>Resident Registration</h1>
    <p class="subtitle">Create an account to file complaints & track ticket progress</p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">⚠️ <%= error %></div>
    <% } %>

    <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="alert-msg">ℹ️ <%= msg %></div>
    <% } %>

    <form id="registerForm" action="/register" method="post" onsubmit="handleSubmit(event)">
        <input type="hidden" name="returnTo" value="<%= (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '' %>">

        <div class="form-group">
            <label>Full Name *</label>
            <input type="text" name="name" required placeholder="e.g. Aarav Sharma" value="<%= (typeof formData !== 'undefined' && formData.name) ? formData.name : '' %>">
        </div>

        <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="email" required placeholder="e.g. resident@society.com" value="<%= (typeof formData !== 'undefined' && formData.email) ? formData.email : '' %>">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Building / Wing</label>
                <select name="wing">
                    <% const selWing = (typeof formData !== 'undefined' && formData.wing) ? formData.wing : 'A'; %>
                    <option value="A" <%= selWing === 'A' ? 'selected' : '' %>>Wing A</option>
                    <option value="B" <%= selWing === 'B' ? 'selected' : '' %>>Wing B</option>
                    <option value="C" <%= selWing === 'C' ? 'selected' : '' %>>Wing C</option>
                    <option value="D" <%= selWing === 'D' ? 'selected' : '' %>>Wing D</option>
                    <option value="E" <%= selWing === 'E' ? 'selected' : '' %>>Wing E</option>
                </select>
            </div>

            <div class="form-group">
                <label>Flat / Apartment No.</label>
                <input type="text" name="flatNo" placeholder="e.g. 402" value="<%= (typeof formData !== 'undefined' && formData.flatNo) ? formData.flatNo : '' %>">
            </div>
        </div>

        <div class="form-group">
            <label>Phone Number (Optional)</label>
            <input type="tel" name="phone" placeholder="e.g. 9876543210" value="<%= (typeof formData !== 'undefined' && formData.phone) ? formData.phone : '' %>">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Password *</label>
                <input type="password" id="password" name="password" required minlength="6" placeholder="At least 6 characters">
            </div>

            <div class="form-group">
                <label>Confirm Password *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="Re-enter password">
            </div>
        </div>
        <div class="password-hint" id="passwordMatchHint"></div>

        <button type="submit" id="submitBtn" class="btn-submit">
            <span>✨ Create Resident Account</span>
        </button>
    </form>

    <div class="switch-auth">
        Already have an account? <a href="/login<%= (typeof returnTo !== 'undefined' && returnTo) ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>">Log in here</a>
    </div>


    <a class="back-link" href="/">← Return to Public Dashboard</a>
</div>

<script>
    const pwdInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const hint = document.getElementById('passwordMatchHint');
    const submitBtn = document.getElementById('submitBtn');

    function checkMatch() {
        if (confirmInput.value.length > 0) {
            if (pwdInput.value === confirmInput.value) {
                hint.textContent = '✓ Passwords match';
                hint.style.color = '#16a34a';
            } else {
                hint.textContent = '✗ Passwords do not match';
                hint.style.color = '#dc2626';
            }
        } else {
            hint.textContent = '';
        }
    }

    pwdInput.addEventListener('input', checkMatch);
    confirmInput.addEventListener('input', checkMatch);

    function handleSubmit(e) {
        if (pwdInput.value !== confirmInput.value) {
            e.preventDefault();
            alert('Passwords do not match! Please check and try again.');
            return false;
        }
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>⏳ Creating Account...</span>';
        return true;
    }
</script>

</body>
</html>
